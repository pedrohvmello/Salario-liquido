# Create a private Supabase project and run supabase/migrations/0001_init.sql.
# VITE_ variables are PUBLIC in browser builds. Never put service_role keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Enable only AFTER Google OAuth provider has been configured and tested in Supabase.
VITE_ENABLE_GOOGLE_OAUTH=false
